# Copia este archivo como deploy/production.env (no se sube a git) y completa los valores.
# build.sh lo copia a app/.env dentro del paquete.
APP_ENV=production
# Genera una clave nueva con: php backend/bin/key.php
APP_KEY=
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Orígenes exactos del sitio, sin barra final ni ruta, separados por coma. Incluye www si el dominio redirige a www.
# Ej.: https://www.expresswebsite.cl,https://expresswebsite.cl
ALLOWED_ORIGINS=
# Subcarpeta (dominio.cl/panorama): /panorama/api/v1  ·  Subdominio con raíz en /panorama: /api/v1
API_PREFIX=/panorama/api/v1
COOKIE_SECURE=true
SESSION_HOURS=12
ALLOW_PUBLIC_REGISTRATION=false
# Vacío = consultas deshabilitadas. Completa solo cuando publiques el aviso de privacidad real.
PRIVACY_NOTICE_VERSION=
MAIL_TRANSPORT=disabled
MAIL_FROM=
WEB_BASE_URL=
