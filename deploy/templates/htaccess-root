# Panorama Inmobiliario, raíz de /panorama (Apache).
# Frontend estático + API en api/. El backend privado vive en app/ y se deniega aparte.
Options -Indexes
DirectoryIndex index.html

# app/ es privado: segunda defensa por si el hosting ignora app/.htaccess.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app(/|$) - [F,L]
</IfModule>

# Archivos ocultos (.env, .git, etc.) nunca se sirven.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(js|css|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
