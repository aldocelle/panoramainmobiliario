APP_ENV=development
APP_KEY=replace-with-64-hex-characters-from-php-bin-key.php
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panorama
DB_USERNAME=panorama
DB_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PREFIX=/api/v1
COOKIE_SECURE=false
SESSION_HOURS=12
ALLOW_PUBLIC_REGISTRATION=false
PRIVACY_NOTICE_VERSION=
# SQLite solo para desarrollo/pruebas; DB_PATH fuera del directorio público.
DB_PATH=var/development.sqlite

# Correo deshabilitado por defecto. Native requiere mail() configurado y cron.
MAIL_TRANSPORT=disabled
MAIL_FROM=
WEB_BASE_URL=
